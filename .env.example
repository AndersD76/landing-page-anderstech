PORT=3001
NODE_ENV=development
# Preenchida automaticamente pelo Railway. Junto com NODE_ENV decide o modo de
# producao (CORS, cookie secure, guarda da ADMIN_KEY). Nao definir manualmente em dev.
# RAILWAY_ENVIRONMENT=production
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
RESEND_API_KEY=re_xxxxxxxxxxxx
NOTIFY_EMAIL=danielanders76@gmail.com
ADMIN_KEY=your-secret-key-here
SESSION_SECRET=your-session-secret-min-32-chars

# Sentry (opcional — erros/perf; deixe vazio para desativar)
SENTRY_DSN=

# ── Asaas (pagamento dos treinamentos) ──────────────────────────────────────
# Chave de API. Painel Asaas > Integracoes > Chave de API.
# NUNCA commitar o valor real: este arquivo vai para um repositorio publico.
ASAAS_API_KEY=

# Token do webhook. Definido por voce no painel (Integracoes > Webhooks) e
# reenviado pelo Asaas no header asaas-access-token. Sem ele o webhook rejeita
# tudo (fail-closed) e nenhuma matricula e liberada.
ASAAS_WEBHOOK_TOKEN=

# Opcional. Padrao: https://api.asaas.com/v3
# Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_URL=

# URL publica da aplicacao, usada em links de retorno e no webhook.
APP_URL=https://anderstech.net

# Promocao de lancamento dos cursos EAD (ver promo.js).
# ENCERRADA em 2026-08-18: os treinamentos passaram a ser pagos.
EAD_PROMO_FIM=2026-07-29T23:59:59-03:00
EAD_PROMO_ATIVA=false

# ── Telemetria (FASE 1 da maquina de trafego) ───────────────────────────────
# Liga/desliga o adaptador. Flag PROPRIA, independente do NODE_ENV que liga o
# GA4: a telemetria roda em dev E em producao. Use "false" para desligar.
TELEMETRY_ENABLED=true

# Servico central de telemetria — AINDA NAO ESTA NO AR.
# Enquanto estiver vazio, o adaptador grava na tabela telemetry_events do Neon
# deste repo, no mesmo schema do central (ver migrations/009_telemetria.sql).
# Quando o central subir: gerar a chave la, colar aqui e no Railway, e trocar o
# transporte na funcao entregar() de telemetry.js.
TELEMETRY_KEY=
TELEMETRY_ENDPOINT=
