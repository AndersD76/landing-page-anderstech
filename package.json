{
  "name": "landing-anderstech",
  "version": "1.0.0",
  "description": "Anders Tech — Gestao com Tecnologia | anderstech.net",
  "type": "module",
  "main": "server.js",
  "engines": { "node": "22.x" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node ead/seed.js",
    "test": "node --test test/asaas.test.js test/cupom.test.js test/consultoria.test.js test/migrate.test.js test/telemetry.test.js test/prova.test.js test/contato.test.js test/pbqph.test.js test/urls.test.js test/crescimento.test.js test/seguranca.test.js test/ead-template.test.js test/empresa.test.js test/email.test.js",
    "optimize:images": "node scripts/optimize-images.mjs",
    "migrate": "node -e \"import('./db/migrate.js').then(async m=>{const {neon}=await import('@neondatabase/serverless');await m.runMigrations(process.env.DATABASE_URL?neon(process.env.DATABASE_URL):null)})\"",
    "indexnow": "node scripts/indexnow.mjs",
    "test:integracao": "node --import ./test/integracao/registra.mjs test/integracao/rotinas.mjs && node test/integracao/fluxos-http.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@neondatabase/serverless": "^1.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^11.12.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.20.2",
    "resend": "^6.38.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "playwright": "^1.65.1",
    "sharp": "^0.35.3"
  }
}
